{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hi5-anihi-one",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/family-shell-router.ts",
  "vars": {
    "OPENAI_PROJECT_ID": "proj_xGBBMJiRALx3Hn9FISmnPgcD",
    "CLOUDFLARE_USAGE_ACCOUNT_ID": "44d44ea5985018a83d093a28f5fb7511",
    "CORE_R2_USAGE_BUCKETS": "anihi-admissions-images,hi5-anihi-family-files"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/admissions-web/data/*", "/data-core/accounts*", "/data-core/operations*", "/data-core/readiness*", "/data-core/roadmap/*"],
    "binding": "ASSETS"
  }
}
