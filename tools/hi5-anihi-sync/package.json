{
  "name": "hi5-anihi-sync",
  "version": "1.0.0",
  "private": true,
  "description": "HI5 ANiHi DATA CORE curriculum synchronization",
  "author": "HI5 ANiHi",
  "type": "module",
  "main": "app/main.mjs",
  "scripts": {
    "start": "node node_modules/electron/install.js && electron .",
    "build": "node build.mjs",
    "package": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "test:gui": "node node_modules/electron/install.js && node test/gui-check.mjs"
  },
  "dependencies": {
    "sharp": "0.35.4",
    "wrangler": "4.131.1",
    "lucide": "0.577.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "kr.hi5anihi.sync",
    "productName": "HI5-ANiHi-Sync",
    "asar": false,
    "npmRebuild": false,
    "directories": { "output": "../../dist-sync/1.0.0" },
    "files": ["app/**/*", ".runtime/**/*", "package.json", "!**/*.map"],
    "win": { "target": ["nsis"], "icon": ".runtime/icon.ico", "signExecutable": false },
    "artifactName": "HI5-ANiHi-Sync-Setup-${version}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "HI5·ANiHi Sync",
      "deleteAppDataOnUninstall": false
    }
  }
}
