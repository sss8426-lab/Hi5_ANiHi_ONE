# Cache content-hashed assets immutably (generated by vinext — kept here because this file replaces the generated one)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# 속도: 브라우저가 JS·CSS·그림을 매번 서버에 다시 묻지 않게 한다.
# 5분 안에는 바로 쓰고, 그 뒤에는 가진 것을 먼저 보여 주면서 뒤에서 새로 확인한다(stale-while-revalidate).
# 화면 파일은 ?v=로 버전을 바꾸므로 새 배포는 새 주소로 바로 받는다. HTML은 여기에 넣지 않는다(항상 새로).
/data-core/*.js
  Cache-Control: public, max-age=300, stale-while-revalidate=604800
/data-core/*.mjs
  Cache-Control: public, max-age=300, stale-while-revalidate=604800
/data-core/*.css
  Cache-Control: public, max-age=300, stale-while-revalidate=604800
/data-core/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/data-core/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/data-core/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/data-core/*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
